    {
      "parameters": {
        "jsCode": "// Deduplicate against the platform's own post history.\n// No local record of what has been posted: the API is the source of truth, so\n// there is no second state to drift or corrupt. Delete a post manually and the\n// article becomes eligible again.\n\nconst rssArticles = $(\"Latest 10 Articles\").all().map(item => item.json);\nconst publishedPosts = $(\"Fetch Post History\").all().map(item => item.json);\n\nlet articleToPost = null;\n\n// Walk newest-first; publish the first article not already on the profile.\nfor (const article of rssArticles) {\n\n  let link = article.link;\n  if (link.endsWith('/')) {\n    link = link.slice(0, -1);   // RSS and the API disagree on trailing slashes\n  }\n\n  let alreadyPosted = false;\n\n  for (const post of publishedPosts) {\n    // The URL can live in the call-to-action button...\n    if (post.callToAction && post.callToAction.url && post.callToAction.url.includes(link)) {\n      alreadyPosted = true;\n      break;\n    }\n    // ...or inline in the post body. Check both.\n    if (post.summary && post.summary.includes(link)) {\n      alreadyPosted = true;\n      break;\n    }\n  }\n\n  if (!alreadyPosted) {\n    articleToPost = article;\n    break;\n  }\n}\n\nif (articleToPost) {\n  return [{ json: articleToPost }];\n} else {\n  // Everything in the feed is already published - halt this run.\n  return [];\n}\n"
      },
