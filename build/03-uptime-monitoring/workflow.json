{
  "name": "Multi-Site Uptime Monitoring",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "id": "REDACTED",
      "name": "Every 30 Minutes"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Per-URL alert suppression.\n// A 30-minute check against a site that stays down for 6 hours would send 12\n// identical emails. After the third, nobody reads them. Workflow static data\n// holds the last-alerted timestamp per URL and suppresses repeats inside the\n// window — the difference between a monitor people trust and one they filter\n// into a folder.\n\nconst staticData = $getWorkflowStaticData('global');\nconst url = $('Endpoint List').item.json.url;\nconst status = $json.statusCode || 0;\nconst now = Date.now();\nconst cooldownMs = 30 * 60 * 1000; // 30 minutes\n\nconst last = staticData['alert_' + url] || 0;\nlet notify = false;\nif (now - last > cooldownMs) {\n  staticData['alert_' + url] = now;\n  notify = true;\n}\nreturn { json: { url, status, notify } };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        -192
      ],
      "id": "REDACTED",
      "name": "Alert Cooldown"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "REDACTED",
              "leftValue": "={{ $json.notify }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        1040,
        -192
      ],
      "id": "REDACTED",
      "name": "Cooldown Passed"
    },
    {
      "parameters": {
        "fromEmail": "monitoring@example.com",
        "toEmail": "alerts@example.com",
        "subject": "=DOWN: {{ $json.url }}",
        "emailFormat": "text",
        "text": "=Endpoint: {{ $json.url }}\nHTTP status: {{ $json.status }} (0 = timeout / no response at all)\nTime (UTC): {{ $now.toFormat('yyyy-LL-dd HH:mm') }}\n\nChecked from the automation host.\n\nDifferential diagnosis:\n- All sites down, panel down      -> server or network is down\n- All sites down, panel responds  -> web server or CDN layer\n- One site down, rest fine        -> application or config on that site",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1248,
        -192
      ],
      "id": "REDACTED",
      "name": "Send Alert",
      "webhookId": "REDACTED",
      "credentials": {
        "smtp": {
          "id": "REDACTED",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "REDACTED",
              "leftValue": "={{ $json.statusCode || 0 }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        624,
        -96
      ],
      "id": "REDACTED",
      "name": "Is Down"
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (X11; Linux x86_64) UptimeMonitor/1.0"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        416,
        0
      ],
      "id": "REDACTED",
      "name": "HTTP Check",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Endpoints under monitoring.\n// The hosting control panel is included on purpose: it turns a binary alert\n// into a diagnosis. See the cooldown node and the alert body below.\n\nconst endpoints = [\n  \"https://foundation.example.org\",\n  \"https://example.com\",\n  \"https://client-a.example.com\",\n  \"https://client-b.example.com\",\n  \"https://client-c.example.com\",\n  \"https://client-d.example.com\",\n  \"https://client-e.example.com\",\n  \"https://client-f.example.com\",\n  \"https://client-g.example.com\",\n  \"https://panel.example.com:PANEL_PORT\"\n];\nreturn endpoints.map(url => ({ json: { url } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "REDACTED",
      "name": "Endpoint List"
    }
  ],
  "pinData": {},
  "connections": {
    "Every 30 Minutes": {
      "main": [
        [
          {
            "node": "Endpoint List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert Cooldown": {
      "main": [
        [
          {
            "node": "Cooldown Passed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cooldown Passed": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Down": {
      "main": [
        [
          {
            "node": "Alert Cooldown",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Check": {
      "main": [
        [
          {
            "node": "Is Down",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Is Down",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Endpoint List": {
      "main": [
        [
          {
            "node": "HTTP Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "timeSavedMode": "fixed",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "versionId": "REDACTED",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "REDACTED"
  },
  "nodeGroups": [],
  "id": "REDACTED",
  "tags": []
}